{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "UI (demo database)",
            "type": "debugpy",
            "request": "launch",
            "module": "ui.ui",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "UI (real database)",
            "type": "debugpy",
            "request": "launch",
            "module": "ui.ui",
            "args": ["--real"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Seed library",
            "type": "debugpy",
            "request": "launch",
            "module": "scripts.seed_library",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Pytest: all tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["tests"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}
